# Supabase Configuration
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Ayrshare API Key (Used by Supabase Edge Function: ayrshare-proxy)
# Get this from your Ayrshare dashboard.
# IMPORTANT: This key should be set as a Supabase Secret, NOT directly in client-side code.
# This variable is for local development setup if you run Edge Functions locally.
VITE_AYRSHARE_API_KEY="your_ayrshare_api_key_here"

# Stripe API Keys (Used by Supabase Edge Functions: stripe-checkout, stripe-portal)
# Get these from your Stripe dashboard.
# IMPORTANT: These keys should be set as Supabase Secrets, NOT directly in client-side code.
# These variables are for local development setup if you run Edge Functions locally.
VITE_STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
VITE_STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# Optional: Google OAuth Credentials (if enabling Google login via Supabase)
# Get these from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
VITE_GOOGLE_OAUTH_SECRETS="your_google_oauth_secret_here"

# Optional: AI/Voice Integration Keys (if these features are implemented)
# These would typically be used by Supabase Edge Functions and set as Supabase Secrets.
VITE_VOICE_ID="your_elevenlabs_voice_id"
VITE_AGENT_ID="your_ai_agent_id"
VITE_ELEVENLABS_API_KEY="your_elevenlabs_api_key"
VITE_GEMINI_API_KEY="your_gemini_api_key"

# Supabase Internal Database URL (for Edge Functions, usually auto-configured)
# You typically don't need to set this manually unless running Supabase locally.
# SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"